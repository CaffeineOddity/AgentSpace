# ToAPIs 配置
#
# 获取 API Key：访问 https://toapis.com/console/token
# 将下方 YOUR_API_KEY 替换为你的真实密钥。
#
# 本文件含敏感信息，已被 .gitignore 忽略，不上传。

# API 密钥（必填）
TOAPIS_API_KEY=your-api-key

# 接口地址（可选）
# 国内用户请使用 https://toapis.cn
TOAPIS_BASE_URL=https://toapis.com

# 默认模型（可选）：省去每次 --model；优先级 --model 显式参数 > 环境变量 > 此处 > 内置默认
# TOAPIS_IMAGE_MODEL=gpt-image-2
# TOAPIS_VIDEO_MODEL=veo3.1-fast
